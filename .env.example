# Documentation only: export server variables in your shell/hosting service.
PORT=3001
DB_PATH=./portfolio.db
UPLOAD_DIR=./uploads
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Leave blank for same-origin frontend/API; Vite reads this during build.
VITE_API_URL=
# Number of reverse-proxy hops to trust for client IP/HTTPS detection (auto "1" on Render).
TRUST_PROXY=
# Vercel configuration only: HTTPS origin of the persistent Express backend.
# Configure this in Vercel's environment variables; not in the browser bundle.
BACKEND_URL=
