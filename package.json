    "express": "^4.21.2",
    "multer": "^2.0.2",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^3.3.6"
  },
  "devDependencies": {
